


* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
}


.principal {
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 30px 4%;
    background: linear-gradient(
        110deg,
        #071f50,
        #006d91,
        #00a6a6
    );
}

.texto {
    flex: 1;
    min-width: 0;
    max-width: 600px;
}

.texto h1 {
    color: #ffffff;
    font-size: clamp(30px, 3.2vw, 46px);
    line-height: 1.15;
    margin-bottom: 22px;
}

.texto p {
    color: #e0eaf0;
    font-size: 18px;
    line-height: 1.5;
    margin-bottom: 28px;
}

.texto button {
    background-color: #00d9d9;
    color: #00334c;
    border: none;
    border-radius: 30px;
    padding: 16px 30px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

.texto button:hover {
    background-color: #ffffff;
}

.contato p {
    color: #ffffff;
    font-size: 16px;
    margin-top: 22px;
    margin-bottom: 0;
}


.imagem {
    flex: 1.5;
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
}

.imagem img {
    width: 100%;
    max-width: 800px;
    height: auto;
    display: block;
    object-fit: contain;
    transform: scale(1.15);
}

.servicos {
    background-color: #f2f7fa;
    padding: 75px 5%;
    text-align: center;
    color: #071f50;
}

.servicos > h2 {
    font-size: 36px;
    margin-bottom: 45px;
}

.container-cards {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 25px;
    max-width: 1200px;
    margin: 0 auto;
}

.card {
    flex: 1;
    min-width: 0;
    background-color: #ffffff;
    padding: 35px 25px;
    border-radius: 15px;
    box-shadow: 0 5px 20px #071f5012;
    border-bottom: 4px solid #00a6a6;
    transition: transform 0.3s;
}

.card:hover {
    transform: translateY(-6px);
}

.icone {
    font-size: 38px;
    margin-bottom: 20px;
}

.card h3 {
    font-size: 22px;
    margin-bottom: 12px;
}

.card h4 {
    color: #008caa;
    font-size: 15px;
    margin-bottom: 18px;
}

.card p {
    color: #586779;
    font-size: 16px;
    line-height: 1.6;
}


@media (max-width: 700px) {
    .principal {
        flex-direction: column;
        align-items: stretch;
        padding: 40px 22px;
        gap: 35px;
    }

    .texto,
    .imagem {
        width: 100%;
        max-width: none;
    }

    .texto h1 {
        font-size: 32px;
    }

    .texto p {
        font-size: 16px;
    }

    .imagem img {
        width: 100%;
        max-width: 500px;
        transform: none;
    }

    .servicos {
        padding: 55px 22px;
    }

    .servicos > h2 {
        font-size: 30px;
        margin-bottom: 30px;
    }

    .container-cards {
        flex-direction: column;
    }

    .card {
        width: 100%;
    }
}

/* Fundo e espaço da seção */
.portfolio {
    background: #f2f7fa;
    padding: 80px 7%;
    color: #071f50;
}

/* Título e apresentação */
.portfolio-cabecalho {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 35px;
}

.portfolio-etiqueta {
    color: #008caa;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 2px;
}

.portfolio-cabecalho h2 {
    font-size: 36px;
    margin: 15px 0;
}

.portfolio-cabecalho > p:last-child {
    color: #586779;
    line-height: 1.6;
}

/* Botões de filtro */
.portfolio-filtros {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 40px;
}

.filtro {
    padding: 10px 20px;
    border: 1px solid #008caa;
    border-radius: 25px;
    background: transparent;
    color: #071f50;
    cursor: pointer;
}

.filtro:hover,
.filtro.ativo {
    background: #008caa;
    color: white;
}

/* PORTFÓLIO */

.portfolio {
    background-color: #ffffff;
    padding: 60px 5%;
    text-align: center;
}

.portfolio-cabecalho h2 {
    color: #172f46;
    font-size: 30px;
    margin-bottom: 18px;
}

.portfolio-filtros {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 30px;
}

.filtro {
    border: none;
    border-radius: 25px;
    padding: 9px 18px;
    background-color: #eeeeee;
    color: #333333;
    cursor: pointer;
    font-size: 13px;
}

.filtro.ativo,
.filtro:hover {
    background-color: #172f46;
    color: #ffffff;
}

.portfolio-galeria {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    max-width: 1100px;
    margin: 0 auto;
}

.projeto {
    background-color: #ffffff;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.15);
    text-align: left;
}

.projeto img {
    width: 100%;
    height: 190px;
    object-fit: cover;
    display: block;
}

.projeto-info {
    background-color: #263238;
    color: #ffffff;
    padding: 12px 15px;
}

.projeto-info h3 {
    font-size: 16px;
    margin-bottom: 5px;
}

.projeto-info p {
    font-size: 12px;
    color: #dddddd;
}

@media (max-width: 700px) {
    .portfolio-galeria {
        grid-template-columns: 1fr;
    }

    .portfolio {
        padding: 40px 20px;
    }
}

